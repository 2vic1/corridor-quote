# seller
PORT=4021
PUBLIC_URL=http://localhost:4021
X402_NETWORK=eip155:42220

# where the money lands
PAY_TO=0xYourMerchantAddress

# price per quote, in the asset's smallest unit (2000 = 0.002 USA₮ at 6 decimals)
PRICE=2000
ASSET_SYMBOL=USA₮

# facilitator key from https://x402.celo.org (dashboard -> connect wallet -> key shown once)
X402_API_KEY=

# leave blank to discover the token address from the facilitator /supported.
# set these only to run fully offline.
ASSET_ADDRESS=
ASSET_DECIMALS=6
ASSET_NAME=USA₮
ASSET_VERSION=1

# buyer
PRIVATE_KEY=0xThrowawayKeyWithAFewCents
TARGET=http://localhost:4021/api/quote

# point this at a local mock to demo without funds
# X402_FACILITATOR_BASE=http://localhost:4022
